  <version>0.1.0</version>
  <description>Spawn the PX4 x500 quadcopter in Gazebo Harmonic and view in RViz</description>
  <maintainer email="you@example.com">dcuav</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
